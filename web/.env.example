# Copy to `.env.local` (git-ignored). Read by the Next.js app.

# Base URL of the Django REST API (no trailing slash).
# NEXT_PUBLIC_* vars are exposed to the browser; the API is public read, so ok.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Origin of the Django server (for media/sitemap/robots links).
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:8000

# This site's own public origin (used in canonical URLs / metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google AdSense (optional) -------------------------------------------
# Leave blank to keep ads off (slots show a house ad or a neutral placeholder).
# When a publisher id is set, any slot WITHOUT a house ad falls back to AdSense.
#
#   NEXT_PUBLIC_ADSENSE_CLIENT: your publisher id, e.g. ca-pub-1234567890123456
#   NEXT_PUBLIC_ADSENSE_SLOT_*: the ad-unit slot id for each on-page placement
#                               (AdSense dashboard -> Ads -> By ad unit).
# NEXT_PUBLIC_ADSENSE_AUTO_ADS=true lets Google place ads ANYWHERE on the page
# (Auto Ads), on top of your named slots. Also enable Auto ads for the site in
# the AdSense dashboard. When true, an empty slot with no configured unit id
# collapses (no placeholder) so Auto Ads can use the space.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_AUTO_ADS=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=
NEXT_PUBLIC_ADSENSE_SLOT_POPUP=
