# Copy to `.env.local` (git-ignored). Read by the Next.js app.

# Base URL of the Django REST API (no trailing slash).
# NEXT_PUBLIC_* vars are exposed to the browser; the API is public read, so ok.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Origin of the Django server (for media/sitemap/robots links).
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:8000

# This site's own public origin (used in canonical URLs / metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
