# Point the app at your running Django API.
#
# Defaults (no .env needed):
#   - iOS simulator      -> http://localhost:8000
#   - Android emulator   -> http://10.0.2.2:8000
#
# A PHYSICAL phone (Expo Go) can't reach "localhost" — it must use your
# computer's LAN IP. Find it (macOS: `ipconfig getifaddr en0`) and set:
#
# EXPO_PUBLIC_API_URL=http://192.168.1.144:8000/api/v1
# EXPO_PUBLIC_BACKEND_ORIGIN=http://192.168.1.144:8000
# EXPO_PUBLIC_SITE_URL=http://192.168.1.144:3000

# --- Google AdMob (optional) ---------------------------------------------
# Leave blank to use Google's official TEST ad units (safe to tap, never bills).
# Set your real unit ids for production. The AdMob *app* ids are in app.json.
# AdMob needs a dev/EAS build — it does NOT run in Expo Go.
# EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
