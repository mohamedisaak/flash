# Copy this file to `.env` (never commit .env) and adjust as needed.
# Loaded automatically by config/settings.py via django-environ.

# --- Core ---
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-dev-key-change-me-in-production-please
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Database ---
# Matches infrastructure/docker-compose.dev.yml. Leave unset to fall back to a
# local SQLite file (fine for quick checks, NOT for real work).
DATABASE_URL=postgres://flash:flash@localhost:5432/flash

# --- Cache / broker ---
# Leave unset to fall back to in-process local-memory cache.
REDIS_URL=redis://localhost:6379/0

# --- Celery (background tasks) ---
# Default to REDIS_URL's host if unset.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set True only in tests to run tasks inline (no worker needed).
CELERY_TASK_ALWAYS_EAGER=False

# --- Media storage (optional S3/MinIO) ---
# Default False = local disk. Set True + `uv sync --extra s3` to use object storage.
USE_S3=False
# S3_ENDPOINT_URL=http://localhost:9000   # e.g. a local MinIO
# S3_BUCKET=flash-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=

# --- SEO / site identity ---
# Public canonical origin of the frontend, used for sitemaps, feeds, JSON-LD.
SITE_URL=http://localhost:3000
ORGANIZATION_NAME=Flash News
# ORGANIZATION_LOGO_URL=https://news.example.com/logo.png

# --- Search ---
# "postgres" (default; falls back to simple matching on SQLite) or "opensearch".
SEARCH_BACKEND=postgres
